<main class="content">
  <section id="about" aria-labelledby="about-title">
    <p class="eyebrow">About</p>
    <h2 id="about-title">Quality engineering with measurable release confidence</h2>
    <p>I design and maintain Java-based web and API automation frameworks, then connect them to CI/CD pipelines so quality checks run as part of every release. My focus is turning complex, multi-service features into testable flows with clear deployment gates.</p>
    <p>At Blibli.com, I helped my squad reach <strong>60%+ automation coverage</strong> across API and web UI testing. I am now looking for a Senior SDET or QA Engineer IC role where I can combine framework design with practical quality coaching.</p>
  </section>

  <section id="projects" aria-labelledby="projects-title">
    <p class="eyebrow">Proof of work</p>
    <h2 id="projects-title">Featured projects</h2>
    <div class="project-grid">
      {% for project in projects %}
      <article class="project-card">
        <div>
          <div class="project-card-meta">
            <span class="project-number">0{{ loop.index }}</span>
            <span class="project-type">{{ project.type }}</span>
          </div>
          <h3>{{ project.name }}</h3>
          <p>{{ project.description }}</p>
          <ul class="tag-list">
            {% for tag in project.tags %}
            <li class="tag-slate">{{ tag }}</li>
            {% endfor %}
          </ul>
        </div>
        <a href="{{ project.url }}" class="text-link" target="_blank" rel="noopener noreferrer">View repository <span aria-hidden="true">↗</span></a>
      </article>
      {% endfor %}
    </div>
  </section>

  <section id="skills" aria-labelledby="skills-title">
    <p class="eyebrow">Capabilities</p>
    <h2 id="skills-title">Skills</h2>
    <div class="skills-grid">
      {% for group in skill_groups %}
      <article class="skill-category">
        <h3>{{ group.title }}</h3>
        <ul class="tag-list">
          {% for item in group.items %}
          <li class="{% if item in group.featured %}tag-brand{% else %}tag-slate tag-pill{% endif %}">{{ item }}</li>
          {% endfor %}
        </ul>
      </article>
      {% endfor %}
    </div>
  </section>

  <section id="experience" aria-labelledby="experience-title">
    <p class="eyebrow">Career</p>
    <h2 id="experience-title">Experience</h2>
    <div class="experience-list">
      {% for job in experience %}
      <article class="experience-item">
        <div class="experience-heading">
          <div class="experience-title-row">
            <h3>{{ job.role }}</h3>
            {% if job.company_url %}
            <a href="{{ job.company_url }}" class="company" target="_blank" rel="noopener noreferrer">{{ job.company }}</a>
            {% else %}
            <p class="company">{{ job.company }}</p>
            {% endif %}
          </div>
          <p class="experience-meta">
            {{ job.dates }} <span class="experience-location">• {{ job.location }}</span>
          </p>
        </div>
        <ul>
          {% for bullet in job.bullets %}
          <li>{{ bullet | safe }}</li>
          {% endfor %}
        </ul>
      </article>
      {% endfor %}
    </div>
  </section>

  <section id="education" aria-labelledby="education-title">
    <p class="eyebrow">Education</p>
    <h2 id="education-title">Education</h2>
    <div class="education-list">
      {% for item in education %}
      <article class="education-item">
        <h3>{{ item.institution }}</h3>
        <p>{{ item.degree }}</p>
        <p class="education-meta">{{ item.period }} • Grade {{ item.grade }}</p>
      </article>
      {% endfor %}
    </div>
  </section>
</main>
