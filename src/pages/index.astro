---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import { projects } from "../data/projects";
import profilePhoto from "../assets/images/profile.png";
import cvUrl from "../assets/Aulia_Mei_Azizi_CV.pdf?url";

const skill_groups = [{title:"Framework design & automation",featured:["Playwright","Playwright APIRequestContext","WebdriverIO","Appium","Cypress","Cucumber BDD"],items:["Playwright","Playwright APIRequestContext","WebdriverIO","Appium","Cypress","Cucumber BDD","Selenium","RestAssured","Page Object Model","Internal automation frameworks"]},{title:"Languages & platforms",featured:["Java","TypeScript","Kotlin Multiplatform","Compose Multiplatform","MCP"],items:["Java","TypeScript","JavaScript","Groovy","Kotlin Multiplatform","Compose Multiplatform","Android","iOS","MCP"]},{title:"CI/CD & release gating",featured:["Maven"],items:["Jenkins","GitLab CI","Maven","Source control workflows","Deployment quality gates"]},{title:"API, data & test management",featured:["REST"],items:["Postman","REST","SQL","MongoDB","Kafka","Jira","TestLink","Test data management"]}];

const experience = [{role:"SDET",company:"Blibli.com",company_url:"https://www.blibli.com",dates:"Jan 2022 – Oct 2025 · 3 yrs 10 mos",location:"Jakarta Metropolitan Area · Hybrid",bullets:["Designed API and web UI automation frameworks for sprint features and releases, reaching <strong>60%+ automation coverage</strong> at squad level.","Built end-to-end automated suites across multiple integrated services for trade-in and B2G e-commerce platforms, coordinating with developers on testable code paths and trigger conditions.","Integrated automated suites into CI/CD via Jenkins and source control workflows, enforcing deployment quality gates so releases only ship when test thresholds are met."]},{role:"Information Technology Quality Assurance",company:"PT. Kognitif Skema Indonesia (Schema.id)",company_url:undefined,dates:"Nov 2018 – Jan 2022 · 3 yrs 3 mos",location:"Central Jakarta, Jakarta, Indonesia",bullets:["Created test documentation from FSD and TSD requirements, giving client-facing projects a traceable quality baseline before delivery.","Reproduced and tracked user-reported issues in Jira across financial services and computer vision projects.","Tested new applications and patches with SQL Server, Postman, DBeaver, Putty, Ubuntu Server, Oracle, and Microsoft Server 2016."]}];

const education = [{institution:"BINUS ONLINE",degree:"Bachelor's degree, Information Systems",period:"2020 – 2022",grade:"3.6"},{institution:"Telkom University",degree:"Associate's degree, Management Information Systems",period:"2015 – 2018",grade:"3.4"}];

const title = "Aulia Mei Azizi | SDET";
const description = "Aulia Mei Azizi is a SDET focused on Java, Playwright, API automation, and quality engineering.";
---
<Base title={title} description={description}>
  <section class="hero" id="overview">
    <div class="hero-copy">
      <p class="eyebrow">Quality Engineering • Test Automation • Open to opportunities</p>
      <h1>Aulia Mei Azizi</h1>
      <p class="position">Senior SDET <span class="position-meta">• Yogyakarta, DIY</span></p>
      <p class="hero-summary">I build reliable automation systems that help product teams ship with confidence.</p>
      <nav class="social-buttons" aria-label="Contact and professional links">
        <a href="mailto:auliameiazizi@gmail.com" class="btn btn-primary">Email me</a>
        <a href="https://www.linkedin.com/in/auliameiazizi/" class="btn btn-secondary" target="_blank" rel="noopener noreferrer">LinkedIn</a>
        <a href="https://github.com/almezi" class="btn btn-secondary" target="_blank" rel="noopener noreferrer">GitHub</a>
        <a href={cvUrl} class="btn btn-secondary" target="_blank" rel="noopener noreferrer">Résumé (PDF)</a>
      </nav>
    </div>
    <div class="avatar-wrap"><div class="avatar-ring"><Image src={profilePhoto} alt="Aulia Mei Azizi profile photo" class="profile-photo" width={260} height={260} loading="eager" /></div></div>
  </section>

  <div class="content">
    <section id="about" aria-labelledby="about-title">
    <p class="eyebrow">Profile</p>
    <h2 id="about-title">About Me</h2>
    <p>I'm an SDET with 7 years of experience across e-commerce and financial services, designing API and web UI automation frameworks in Java, Playwright, and TypeScript. At Blibli.com, I helped my squad reach <strong>60%+ automation coverage</strong>, and I build the tooling around the tests — CI/CD quality gates and, most recently, a mobile testing platform with Appium and WebdriverIO. I'm now looking for a Senior SDET or QA Engineer IC role where I can combine framework design with practical quality coaching.</p>
  </section>

  <section id="projects" aria-labelledby="projects-title">
    <p class="eyebrow">Proof of work</p>
    <h2 id="projects-title">Featured projects</h2>
    <div class="carousel" aria-roledescription="carousel" aria-label="Featured projects">
      <div class="carousel-track" tabindex="0" data-carousel-track>
        {projects.map((project, index) => (
          <div class="carousel-slide" role="group" aria-roledescription="slide" aria-label={`${index + 1} of ${projects.length}`}>
            <article class="project-card">
              <div>
                <div class="project-card-meta">
                  <span class="project-number">0{index + 1}</span>
                  <span class="project-type">{project.type}</span>
                </div>
                <h3>{project.name}</h3>
                <p>{project.description}</p>
                <ul class="tag-list">
                  {project.tags.map((tag) => (
                    <li class="tag-slate">{tag}</li>
                  ))}
                </ul>
              </div>
              <a href={project.url} class="text-link" target="_blank" rel="noopener noreferrer">View repository <span aria-hidden="true">↗</span></a>
            </article>
          </div>
        ))}
      </div>
      <div class="carousel-controls" data-carousel-controls hidden>
        <button type="button" class="carousel-btn" data-carousel-prev aria-label="Previous projects">
          <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12.5 4.5 7 10l5.5 5.5" /></svg>
        </button>
        <div class="carousel-dots" data-carousel-dots></div>
        <button type="button" class="carousel-btn" data-carousel-next aria-label="Next projects">
          <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7.5 4.5 13 10l-5.5 5.5" /></svg>
        </button>
      </div>
    </div>
  </section>

  <section id="skills" aria-labelledby="skills-title">
    <p class="eyebrow">Capabilities</p>
    <h2 id="skills-title">Skills</h2>
    <div class="skills-grid">
      {skill_groups.map((group) => (
        <article class="skill-category">
          <h3>{group.title}</h3>
          <ul class="tag-list">
            {group.items.map((item) => (
              <li class={group.featured.includes(item) ? "tag-brand" : "tag-slate tag-pill"}>{item}</li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </section>

  <section id="experience" aria-labelledby="experience-title">
    <p class="eyebrow">Career</p>
    <h2 id="experience-title">Experience</h2>
    <div class="experience-list">
      {experience.map((job) => (
        <article class="experience-item">
          <div class="experience-heading">
            <div class="experience-title-row">
              <h3>{job.role}</h3>
              {job.company_url ? (
                <a href={job.company_url} class="company" target="_blank" rel="noopener noreferrer">{job.company}</a>
              ) : (
                <p class="company">{job.company}</p>
              )}
            </div>
            <p class="experience-meta">
              {job.dates} <span class="experience-location">• {job.location}</span>
            </p>
          </div>
          <ul>
            {job.bullets.map((bullet) => (
              <li set:html={bullet}></li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </section>

  <section id="education" aria-labelledby="education-title">
    <p class="eyebrow">Credentials</p>
    <h2 id="education-title">Education</h2>
    <div class="education-list">
      {education.map((item) => (
        <article class="education-item">
          <h3>{item.institution}</h3>
          <p>{item.degree}</p>
          <p class="education-meta">{item.period} • Grade {item.grade}</p>
        </article>
      ))}
    </div>
  </section>
  </div>
</Base>

<script>
  const track = document.querySelector<HTMLElement>("[data-carousel-track]");

  if (track) {
    const controls = track.parentElement?.querySelector<HTMLElement>("[data-carousel-controls]") ?? null;
    const prevButton = controls?.querySelector<HTMLButtonElement>("[data-carousel-prev]") ?? null;
    const nextButton = controls?.querySelector<HTMLButtonElement>("[data-carousel-next]") ?? null;
    const dotsContainer = controls?.querySelector<HTMLElement>("[data-carousel-dots]") ?? null;
    const slides = Array.from(track.querySelectorAll<HTMLElement>(".carousel-slide"));
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

    let pageCount = 1;
    let perView = 1;
    let currentPage = 0;

    function measure() {
      const slideWidth = slides[0]?.offsetWidth ?? track.clientWidth;
      const origin = slides[0]?.offsetLeft ?? 0;
      // Count the slides that fit fully inside the viewport (1px tolerance for subpixel rounding).
      perView = Math.max(
        1,
        slides.filter((slide) => slide.offsetLeft - origin + slideWidth <= track.clientWidth + 1).length
      );
      pageCount = Math.max(1, Math.ceil(slides.length / perView));
      currentPage = Math.min(currentPage, pageCount - 1);
    }

    function pageScrollLeft(page: number) {
      const pageStride =
        slides.length > perView ? slides[perView].offsetLeft - slides[0].offsetLeft : track.clientWidth;
      return Math.min(Math.max(page * pageStride, 0), track.scrollWidth - track.clientWidth);
    }

    function activePage() {
      let best = 0;
      let bestDistance = Infinity;
      for (let page = 0; page < pageCount; page += 1) {
        const distance = Math.abs(track.scrollLeft - pageScrollLeft(page));
        if (distance < bestDistance) {
          bestDistance = distance;
          best = page;
        }
      }
      return best;
    }

    function goTo(page: number) {
      const behavior: ScrollBehavior = reducedMotion.matches ? "auto" : "smooth";
      track.scrollTo({ left: pageScrollLeft(page), behavior });
    }

    function render() {
      currentPage = activePage();
      if (prevButton) prevButton.disabled = currentPage === 0;
      if (nextButton) nextButton.disabled = currentPage === pageCount - 1;
      dotsContainer?.querySelectorAll("button").forEach((dot, index) => {
        // UIPageControl-style: dots shrink as they get further from the active page.
        dot.dataset.d = String(Math.min(Math.abs(index - currentPage), 3));
        dot.setAttribute("aria-current", index === currentPage ? "true" : "false");
      });
    }

    function buildDots() {
      if (!dotsContainer) return;
      dotsContainer.textContent = "";
      for (let page = 0; page < pageCount; page += 1) {
        const dot = document.createElement("button");
        dot.type = "button";
        dot.className = "carousel-dot";
        dot.setAttribute("aria-label", `Go to projects page ${page + 1}`);
        dot.addEventListener("click", () => goTo(page));
        dotsContainer.append(dot);
      }
    }

    function setup() {
      measure();
      if (controls) controls.hidden = pageCount < 2;
      buildDots();
      track.scrollTo({ left: pageScrollLeft(currentPage), behavior: "auto" });
      render();
    }

    prevButton?.addEventListener("click", () => goTo(currentPage - 1));
    nextButton?.addEventListener("click", () => goTo(currentPage + 1));

    let scrollFrame = 0;
    track.addEventListener(
      "scroll",
      () => {
        cancelAnimationFrame(scrollFrame);
        scrollFrame = requestAnimationFrame(render);
      },
      { passive: true }
    );

    // ResizeObserver fires after relayout; debounce so setup re-measures once
    // the viewport stops moving instead of fighting the browser's mid-resize re-snap.
    let setupTimer = 0;
    new ResizeObserver(() => {
      clearTimeout(setupTimer);
      setupTimer = setTimeout(setup, 150);
    }).observe(track);

    setup();
  }
</script>